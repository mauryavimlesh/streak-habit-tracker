# Server Environment Variables
# The Google Gemini API key must be set in your Vercel/Node deployment environment.
# This key is kept strictly on the backend and is never exposed to the browser.
GEMINI_API_KEY=your_gemini_api_key_here

# Resend Transactional Email API for STREAK Help & Support Form
RESEND_API_KEY=
FEEDBACK_RECEIVER_EMAIL=
FEEDBACK_SENDER_EMAIL=

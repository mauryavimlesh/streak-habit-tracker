{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "userName": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "mainGoal": { "type": "string" },
        "selectedGoals": { "type": "array", "items": { "type": "string" } },
        "routinePreference": { "type": "string" },
        "appearancePreference": { "type": "string" },
        "hasCompletedOnboarding": { "type": "boolean" },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "name", "createdAt", "updatedAt"]
    },
    "Habit": {
      "title": "Habit",
      "description": "A habit to track",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "frequencyType": { "type": "string", "enum": ["daily", "selected_days", "weekly", "custom"] },
        "frequencyValue": { "type": "array", "items": { "type": "string" } },
        "targetType": { "type": "string", "enum": ["binary", "count", "duration", "quantity"] },
        "targetValue": { "type": "number" },
        "targetUnit": { "type": "string" },
        "reminderTime": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "frequencyType", "targetType", "createdAt", "updatedAt"]
    },
    "HabitLog": {
      "title": "Habit Log",
      "description": "A daily record of a habit",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "habitId": { "type": "string" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "status": { "type": "string", "enum": ["completed", "partial", "in_progress", "missed", "skipped"] },
        "progressValue": { "type": "number" },
        "reflection": { "type": "string", "description": "Optional one-line reflection for the day" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "habitId", "date", "status", "createdAt", "updatedAt"]
    },
    "Goal": {
      "title": "Goal",
      "description": "User goals and targets",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "target": { "type": "number" },
        "dailyTarget": { "type": "number" },
        "currentProgress": { "type": "number" },
        "unit": { "type": "string" },
        "targetDate": { "type": "string" },
        "deadline": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "type": { "type": "string", "enum": ["daily", "weekly", "monthly", "one_time", "long_term"] },
        "status": { "type": "string", "enum": ["in_progress", "completed", "paused", "archived"] },
        "subjects": { "type": "array", "items": { "type": "string" } },
        "milestones": { "type": "array", "items": { "type": "string" } },
        "linkedHabitIds": { "type": "array", "items": { "type": "string" } },
        "dailyHistory": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Focus timer sessions, study sessions, and work logs",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "time": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "notes": { "type": "string" },
        "linkedHabitId": { "type": "string" },
        "linkedGoalId": { "type": "string" },
        "linkedGoalActivityId": { "type": "string" },
        "linkedTaskId": { "type": "string" },
        "completionStatus": { "type": "string", "enum": ["completed", "partial", "abandoned"] },
        "subject": { "type": "string" },
        "quantityCompleted": { "type": "number" },
        "unit": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "durationMinutes", "date"]
    },
    "JournalLog": {
      "title": "Journal Log",
      "description": "Daily reflection logs and structured journal entries",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "text": { "type": "string" },
        "time": { "type": "string" },
        "mood": { "type": "string", "enum": ["great", "good", "neutral", "tired", "stressed"] },
        "title": { "type": "string" },
        "prompt": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "images": { "type": "array", "items": { "type": "string" } },
        "linkedHabitIds": { "type": "array", "items": { "type": "string" } },
        "linkedGoalIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "text", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "User scheduled tasks, events, and meetings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "time": { "type": "string" },
        "timeEnd": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "type": { "type": "string", "enum": ["task", "meeting", "event", "reminder"] },
        "completed": { "type": "boolean" },
        "repeat": { "type": "string" },
        "unit": { "type": "string", "description": "Tracking unit e.g. pages, minutes, questions" },
        "targetQuantity": { "type": "number" },
        "progressQuantity": { "type": "number" },
        "isArchived": { "type": "boolean" },
        "archivedAt": { "type": "string", "format": "date-time" },
        "linkedGoalId": { "type": "string" },
        "linkedGoalActivityId": { "type": "string" },
        "linkedHabitId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "completed"]
    },
    "ArchivedTask": {
      "title": "Archived Task",
      "description": "Completed tasks older than 30 days stored in archive",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "time": { "type": "string" },
        "timeEnd": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "type": { "type": "string", "enum": ["task", "meeting", "event", "reminder"] },
        "completed": { "type": "boolean" },
        "unit": { "type": "string" },
        "targetQuantity": { "type": "number" },
        "progressQuantity": { "type": "number" },
        "isArchived": { "type": "boolean" },
        "archivedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "completed"]
    },
    "ArchivedTask": {
      "title": "Archived Task",
      "description": "Historical archived tasks moved to maintain active performance",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "originalDate": { "type": "string", "description": "YYYY-MM-DD" },
        "time": { "type": "string" },
        "timeEnd": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "type": { "type": "string", "enum": ["task", "meeting", "event", "reminder"] },
        "completed": { "type": "boolean" },
        "repeat": { "type": "string" },
        "linkedGoalId": { "type": "string" },
        "linkedGoalActivityId": { "type": "string" },
        "linkedHabitId": { "type": "string" },
        "archivedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "completed"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "User reminders and timed prompts",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "time": { "type": "string" },
        "repeat": { "type": "string" },
        "enabled": { "type": "boolean" },
        "notificationEnabled": { "type": "boolean" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "days": { "type": "array", "items": { "type": "string" } },
        "date": { "type": "string" },
        "linkedHabitId": { "type": "string" },
        "linkedEntityName": { "type": "string" },
        "soundTone": { "type": "string" },
        "customAudioId": { "type": "string" },
        "customAudioName": { "type": "string" },
        "volume": { "type": "number" },
        "vibrate": { "type": "boolean" },
        "vibrationPattern": { "type": "string" },
        "snoozeEnabled": { "type": "boolean" },
        "snoozeMinutes": { "type": "number" },
        "snoozeUntil": { "type": "string" },
        "snoozeCount": { "type": "number" },
        "lastTriggeredAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "time", "repeat", "enabled", "notificationEnabled", "category"]
    },
    "Username": {
      "title": "Username",
      "description": "Unique username registry",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "normalized": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "normalized"]
    },
    "Friend": {
      "title": "Friend",
      "description": "Reciprocal friendship connections",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "friendUid": { "type": "string" },
        "friendUsername": { "type": "string" },
        "status": { "type": "string", "enum": ["accepted", "blocked", "removed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "friendUid", "friendUsername", "status", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Friend request invitations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderUsername": { "type": "string" },
        "senderDisplayName": { "type": "string" },
        "receiverUid": { "type": "string" },
        "receiverUsername": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "senderUid", "senderUsername", "receiverUid", "receiverUsername", "status", "createdAt"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Captures invitee/inviter relationship and activation state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "inviterUid": { "type": "string" },
        "inviterUsername": { "type": "string" },
        "newUserId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "rewardAccountCreatedGranted": { "type": "boolean" },
        "rewardFirstHabitGranted": { "type": "boolean" },
        "status": { "type": "string", "enum": ["registered", "activated"] },
        "activatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "inviterUid", "newUserId", "createdAt", "rewardAccountCreatedGranted", "rewardFirstHabitGranted", "status"]
    },
    "Invite": {
      "title": "Invite",
      "description": "User referral codes and tracking",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "inviterUid": { "type": "string" },
        "inviterUsername": { "type": "string" },
        "inviterDisplayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["code", "inviterUid", "inviterUsername", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "usernames/{usernameId}": {
      "schema": { "$ref": "#/entities/Username" },
      "description": "Unique username registry"
    },
    "habits/{habitId}": {
      "schema": { "$ref": "#/entities/Habit" },
      "description": "User habits"
    },
    "habit_logs/{logId}": {
      "schema": { "$ref": "#/entities/HabitLog" },
      "description": "Logs of habit completion"
    },
    "goals/{goalId}": {
      "schema": { "$ref": "#/entities/Goal" },
      "description": "User goals"
    },
    "journal_logs/{logId}": {
      "schema": { "$ref": "#/entities/JournalLog" },
      "description": "Daily reflection logs"
    },
    "tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "User scheduled tasks and calendar items"
    },
    "archived_tasks/{taskId}": {
      "schema": { "$ref": "#/entities/ArchivedTask" },
      "description": "Historical archived user tasks older than 30 days"
    },
    "activities/{activityId}": {
      "schema": { "$ref": "#/entities/Activity" },
      "description": "User focus sessions and study activities"
    },
    "reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/Reminder" },
      "description": "User notifications and reminders"
    },
    "friends/{friendshipId}": {
      "schema": { "$ref": "#/entities/Friend" },
      "description": "Reciprocal user connections"
    },
    "friend_requests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Pending and past friend requests"
    },
    "referrals/{referralId}": {
      "schema": { "$ref": "#/entities/Referral" },
      "description": "Attributed referrals and XP tracking"
    },
    "invites/{inviteCode}": {
      "schema": { "$ref": "#/entities/Invite" },
      "description": "Unique invite links registry"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all deny as required by the Eight Pillars
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Core Validation Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }
    
    // 2. Authentication Validation
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val == request.time || val is timestamp || (val is string && val.size() <= 50);
    }

    // 3. Entity Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['name']) 
        && data.name is string && data.name.size() <= 100
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('mainGoal' in data) || (data.mainGoal is string && data.mainGoal.size() <= 200))
        && (!('selectedGoals' in data) || (data.selectedGoals is list && data.selectedGoals.size() <= 10))
        && (!('hasCompletedOnboarding' in data) || data.hasCompletedOnboarding is bool)
        && (!('onboardingCompleted' in data) || data.onboardingCompleted is bool)
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 200000))
        && (!('userName' in data) || (data.userName is string && data.userName.size() <= 100))
        && (!('userNameNormalized' in data) || (data.userNameNormalized is string && data.userNameNormalized.size() <= 100))
        && (!('routinePreference' in data) || (data.routinePreference is string && data.routinePreference.size() <= 100))
        && (!('appearancePreference' in data) || (data.appearancePreference is string && data.appearancePreference.size() <= 500));
    }

    function isValidUsernameDoc(data) {
      return data.keys().hasAll(['uid', 'username', 'normalized'])
        && data.uid is string && data.uid.size() <= 128
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 50
        && data.normalized is string && data.normalized.size() >= 3 && data.normalized.size() <= 50
        && (!('createdAt' in data) || isValidTimestamp(data.createdAt))
        && (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidHabit(data) {
      return data.keys().hasAll(['userId', 'name', 'category', 'frequencyType', 'targetType'])
        && isOwner(data.userId)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.category is string && data.category.size() <= 50
        && (!('icon' in data) || (data.icon is string && data.icon.size() <= 50))
        && (!('color' in data) || (data.color is string && data.color.size() <= 50))
        && data.frequencyType is string && data.frequencyType.matches('^(daily|selected_days|weekly|custom)$')
        && (!('frequencyValue' in data) || (data.frequencyValue is list && data.frequencyValue.size() <= 31))
        && data.targetType is string && data.targetType.matches('^(binary|count|duration|quantity)$')
        && (!('targetValue' in data) || data.targetValue is number)
        && (!('minimumTarget' in data) || data.minimumTarget is number)
        && (!('targetUnit' in data) || (data.targetUnit is string && data.targetUnit.size() <= 50))
        && (!('reminderTime' in data) || (data.reminderTime is string && data.reminderTime.size() <= 10))
        && (!('archived' in data) || data.archived is bool);
    }

    function isValidHabitLog(data) {
      return data.keys().hasAll(['userId', 'habitId', 'date', 'status'])
        && isOwner(data.userId)
        && data.habitId is string && data.habitId.size() <= 128
        && data.date is string && data.date.size() <= 10
        && data.status is string && data.status.matches('^(completed|partial|missed|skipped|in_progress|failed)$')
        && (!('progressValue' in data) || data.progressValue is number)
        && (!('targetValue' in data) || data.targetValue is number)
        && (!('minimumTarget' in data) || data.minimumTarget is number)
        && (!('targetUnit' in data) || (data.targetUnit is string && data.targetUnit.size() <= 50))
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 50) || data.completedAt is timestamp)
        && (!('note' in data) || (data.note is string && data.note.size() <= 1000))
        && (!('reflection' in data) || (data.reflection is string && data.reflection.size() <= 5000));
    }

    function isValidGoal(data) {
      return data.keys().hasAll(['userId', 'title'])
        && isOwner(data.userId)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('target' in data) || data.target is number)
        && (!('dailyTarget' in data) || data.dailyTarget is number)
        && (!('currentProgress' in data) || data.currentProgress is number)
        && (!('unit' in data) || (data.unit is string && data.unit.size() <= 50))
        && (!('targetDate' in data) || (data.targetDate is string && data.targetDate.size() <= 20))
        && (!('deadline' in data) || data.deadline is timestamp || (data.deadline is string && data.deadline.size() <= 50))
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && (!('priority' in data) || (data.priority is string && data.priority.matches('^(low|medium|high)$')))
        && (!('type' in data) || (data.type is string && data.type.matches('^(daily|weekly|monthly|one_time|long_term)$')))
        && (!('status' in data) || (data.status is string && data.status.matches('^(in_progress|completed|paused|archived)$')))
        && (!('subjects' in data) || (data.subjects is list && data.subjects.size() <= 50))
        && (!('milestones' in data) || (data.milestones is list && data.milestones.size() <= 50))
        && (!('linkedHabitIds' in data) || (data.linkedHabitIds is list && data.linkedHabitIds.size() <= 50))
        && (!('dailyHistory' in data) || data.dailyHistory is map);
    }

    function isValidJournalLog(data) {
      return data.keys().hasAll(['userId', 'date', 'text'])
        && isOwner(data.userId)
        && data.date is string && data.date.size() <= 10
        && data.text is string && data.text.size() <= 10000
        && (!('time' in data) || (data.time is string && data.time.size() <= 50))
        && (!('mood' in data) || (data.mood is string && data.mood.matches('^(great|good|neutral|tired|stressed)$')))
        && (!('title' in data) || (data.title is string && data.title.size() <= 200))
        && (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 1000))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 50))
        && (!('images' in data) || (data.images is list && data.images.size() <= 20))
        && (!('linkedHabitIds' in data) || (data.linkedHabitIds is list && data.linkedHabitIds.size() <= 50))
        && (!('linkedGoalIds' in data) || (data.linkedGoalIds is list && data.linkedGoalIds.size() <= 50));
    }

    function isValidTask(data) {
      return data.keys().hasAll(['userId', 'title', 'date', 'completed'])
        && isOwner(data.userId)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.date is string && data.date.size() <= 10
        && data.completed is bool
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('time' in data) || (data.time is string && data.time.size() <= 50))
        && (!('timeEnd' in data) || (data.timeEnd is string && data.timeEnd.size() <= 50))
        && (!('repeat' in data) || (data.repeat is string && data.repeat.size() <= 50))
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && (!('priority' in data) || (data.priority is string && data.priority.matches('^(low|medium|high)$')))
        && (!('type' in data) || (data.type is string && data.type.matches('^(task|meeting|event|reminder)$')))
        && (!('unit' in data) || (data.unit is string && data.unit.size() <= 50))
        && (!('targetQuantity' in data) || data.targetQuantity is number)
        && (!('progressQuantity' in data) || data.progressQuantity is number)
        && (!('isArchived' in data) || data.isArchived is bool)
        && (!('archivedAt' in data) || isValidTimestamp(data.archivedAt) || (data.archivedAt is string && data.archivedAt.size() <= 50))
        && (!('linkedGoalId' in data) || (data.linkedGoalId is string && data.linkedGoalId.size() <= 128))
        && (!('linkedGoalActivityId' in data) || (data.linkedGoalActivityId is string && data.linkedGoalActivityId.size() <= 128))
        && (!('linkedHabitId' in data) || (data.linkedHabitId is string && data.linkedHabitId.size() <= 128));
    }

    function isValidArchivedTask(data) {
      return data.keys().hasAll(['userId', 'title', 'date', 'completed'])
        && isOwner(data.userId)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.date is string && data.date.size() <= 10
        && data.completed is bool
        && (!('originalDate' in data) || (data.originalDate is string && data.originalDate.size() <= 10))
        && (!('originalTaskId' in data) || (data.originalTaskId is string && data.originalTaskId.size() <= 128))
        && (!('archivedAt' in data) || isValidTimestamp(data.archivedAt) || (data.archivedAt is string && data.archivedAt.size() <= 50))
        && (!('isArchived' in data) || data.isArchived is bool)
        && (!('unit' in data) || (data.unit is string && data.unit.size() <= 50))
        && (!('targetQuantity' in data) || data.targetQuantity is number)
        && (!('progressQuantity' in data) || data.progressQuantity is number)
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('time' in data) || (data.time is string && data.time.size() <= 50))
        && (!('timeEnd' in data) || (data.timeEnd is string && data.timeEnd.size() <= 50))
        && (!('repeat' in data) || (data.repeat is string && data.repeat.size() <= 50))
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && (!('priority' in data) || (data.priority is string && data.priority.matches('^(low|medium|high)$')))
        && (!('type' in data) || (data.type is string && data.type.matches('^(task|meeting|event|reminder)$')))
        && (!('linkedGoalId' in data) || (data.linkedGoalId is string && data.linkedGoalId.size() <= 128))
        && (!('linkedGoalActivityId' in data) || (data.linkedGoalActivityId is string && data.linkedGoalActivityId.size() <= 128))
        && (!('linkedHabitId' in data) || (data.linkedHabitId is string && data.linkedHabitId.size() <= 128));
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['userId', 'name', 'durationMinutes', 'date'])
        && isOwner(data.userId)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.durationMinutes is number
        && (!('durationSeconds' in data) || data.durationSeconds is number)
        && data.date is string && data.date.size() <= 10
        && (!('time' in data) || (data.time is string && data.time.size() <= 50))
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 50))
        && (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && (!('completionStatus' in data) || (data.completionStatus is string && data.completionStatus.matches('^(completed|partial|abandoned)$')))
        && (!('linkedHabitId' in data) || (data.linkedHabitId is string && data.linkedHabitId.size() <= 128))
        && (!('linkedGoalId' in data) || (data.linkedGoalId is string && data.linkedGoalId.size() <= 128))
        && (!('linkedGoalActivityId' in data) || (data.linkedGoalActivityId is string && data.linkedGoalActivityId.size() <= 128))
        && (!('linkedTaskId' in data) || (data.linkedTaskId is string && data.linkedTaskId.size() <= 128))
        && (!('subject' in data) || (data.subject is string && data.subject.size() <= 100))
        && (!('quantityCompleted' in data) || data.quantityCompleted is number)
        && (!('unit' in data) || (data.unit is string && data.unit.size() <= 50));
    }

    function isValidReminder(data) {
      return data.keys().hasAll(['userId', 'title', 'time', 'repeat', 'enabled', 'notificationEnabled', 'category'])
        && isOwner(data.userId)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.time is string && data.time.size() <= 50
        && data.repeat is string && data.repeat.size() <= 50
        && data.enabled is bool
        && data.notificationEnabled is bool
        && data.category is string && data.category.size() <= 50
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('days' in data) || (data.days is list && data.days.size() <= 7))
        && (!('date' in data) || (data.date is string && data.date.size() <= 20))
        && (!('lastTriggeredAt' in data) || (data.lastTriggeredAt is string && data.lastTriggeredAt.size() <= 50))
        && (!('linkedHabitId' in data) || (data.linkedHabitId is string && data.linkedHabitId.size() <= 128))
        && (!('linkedEntityName' in data) || (data.linkedEntityName is string && data.linkedEntityName.size() <= 200))
        && (!('soundTone' in data) || (data.soundTone is string && data.soundTone.size() <= 50))
        && (!('customAudioId' in data) || (data.customAudioId is string && data.customAudioId.size() <= 100))
        && (!('customAudioName' in data) || (data.customAudioName is string && data.customAudioName.size() <= 200))
        && (!('vibrate' in data) || data.vibrate is bool)
        && (!('vibrationPattern' in data) || (data.vibrationPattern is string && data.vibrationPattern.size() <= 50))
        && (!('volume' in data) || data.volume is number)
        && (!('snoozeEnabled' in data) || data.snoozeEnabled is bool)
        && (!('snoozeMinutes' in data) || data.snoozeMinutes is number)
        && (!('snoozeUntil' in data) || (data.snoozeUntil is string && data.snoozeUntil.size() <= 50))
        && (!('snoozeCount' in data) || data.snoozeCount is number);
    }

    // 4. Collection Rules
    
    // Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidUser(incoming())
        && (!('createdAt' in incoming()) || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow update: if isOwner(userId)
        && isValidUser(incoming())
        && (!('createdAt' in incoming()) || !('createdAt' in existing()) || incoming().createdAt == existing().createdAt || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Usernames (Atomic claim registry & public handle lookup)
    match /usernames/{usernameId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if request.auth != null 
        && isValidId(usernameId)
        && incoming().uid == request.auth.uid
        && isValidUsernameDoc(incoming());
      allow update: if request.auth != null
        && isValidId(usernameId)
        && existing().uid == request.auth.uid
        && incoming().uid == request.auth.uid
        && isValidUsernameDoc(incoming());
      allow delete: if request.auth != null 
        && isValidId(usernameId)
        && existing().uid == request.auth.uid;
    }

    // Habits
    match /habits/{habitId} {
      allow get: if request.auth != null && (resource == null || isOwner(resource.data.userId));
      allow list: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId)
        && isValidId(habitId)
        && isValidHabit(incoming())
        && (!('createdAt' in incoming()) || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow update: if isOwner(existing().userId)
        && isOwner(incoming().userId)
        && isValidHabit(incoming())
        && (!('createdAt' in incoming()) || !('createdAt' in existing()) || incoming().createdAt == existing().createdAt || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow delete: if isOwner(existing().userId);
    }

    // Habit Logs
    match /habit_logs/{logId} {
      allow get: if request.auth != null && (resource == null || isOwner(resource.data.userId));
      allow list: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId)
        && isValidId(logId)
        && isValidHabitLog(incoming())
        && (!('createdAt' in incoming()) || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow update: if isOwner(existing().userId)
        && isOwner(incoming().userId)
        && isValidHabitLog(incoming())
        && (!('createdAt' in incoming()) || !('createdAt' in existing()) || incoming().createdAt == existing().createdAt || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow delete: if isOwner(existing().userId);
    }

    // Goals
    match /goals/{goalId} {
      allow get: if request.auth != null && (resource == null || isOwner(resource.data.userId));
      allow list: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId)
        && isValidId(goalId)
        && isValidGoal(incoming())
        && (!('createdAt' in incoming()) || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow update: if isOwner(existing().userId)
        && isOwner(incoming().userId)
        && isValidGoal(incoming())
        && (!('createdAt' in incoming()) || !('createdAt' in existing()) || incoming().createdAt == existing().createdAt || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow delete: if isOwner(existing().userId);
    }

    // Journal Logs
    match /journal_logs/{logId} {
      allow get: if request.auth != null && (resource == null || isOwner(resource.data.userId));
      allow list: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId)
        && isValidId(logId)
        && isValidJournalLog(incoming())
        && (!('createdAt' in incoming()) || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow update: if isOwner(existing().userId)
        && isOwner(incoming().userId)
        && isValidJournalLog(incoming())
        && (!('createdAt' in incoming()) || !('createdAt' in existing()) || incoming().createdAt == existing().createdAt || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow delete: if isOwner(existing().userId);
    }

    // Reminders
    match /reminders/{reminderId} {
      allow get: if request.auth != null && (resource == null || isOwner(resource.data.userId));
      allow list: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId)
        && isValidId(reminderId)
        && isValidReminder(incoming())
        && (!('createdAt' in incoming()) || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow update: if isOwner(existing().userId)
        && isOwner(incoming().userId)
        && isValidReminder(incoming())
        && (!('createdAt' in incoming()) || !('createdAt' in existing()) || incoming().createdAt == existing().createdAt || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow delete: if isOwner(existing().userId);
    }

    // Tasks
    match /tasks/{taskId} {
      allow get: if request.auth != null && (resource == null || isOwner(resource.data.userId));
      allow list: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId)
        && isValidId(taskId)
        && isValidTask(incoming())
        && (!('createdAt' in incoming()) || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow update: if isOwner(existing().userId)
        && isOwner(incoming().userId)
        && isValidTask(incoming())
        && (!('createdAt' in incoming()) || !('createdAt' in existing()) || incoming().createdAt == existing().createdAt || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow delete: if isOwner(existing().userId);
    }

    // Archived Tasks (Dedicated historical store for tasks older than 30 days)
    match /archived_tasks/{taskId} {
      allow get: if request.auth != null && (resource == null || isOwner(resource.data.userId));
      allow list: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId)
        && isValidId(taskId)
        && isValidArchivedTask(incoming())
        && (!('createdAt' in incoming()) || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow update: if isOwner(existing().userId)
        && isOwner(incoming().userId)
        && isValidArchivedTask(incoming())
        && (!('createdAt' in incoming()) || !('createdAt' in existing()) || incoming().createdAt == existing().createdAt || isValidTimestamp(incoming().createdAt))
        && (!('updatedAt' in incoming()) || isValidTimestamp(incoming().updatedAt));
      allow delete: if isOwner(existing().userId);
    }

    // Activities (Focus Sessions & Study Activities)
    match /activities/{activityId} {
      allow get: if request.auth != null && (resource == null || isOwner(resource.data.userId));
      allow list: if isOwner(resource.data.userId);
      allow create: if isOwner(incoming().userId)
        && isValidId(activityId)
        && isValidActivity(incoming())
        && (!('createdAt' in incoming()) || isValidTimestamp(incoming().createdAt));
      allow update: if isOwner(existing().userId)
        && isOwner(incoming().userId)
        && isValidActivity(incoming());
      allow delete: if isOwner(existing().userId);
    }

    // Feedback & Support Submissions
    match /feedback/{feedbackId} {
      allow get: if request.auth != null && (resource == null || isOwner(resource.data.userId));
      allow list: if request.auth != null && isOwner(resource.data.userId);
      allow create: if incoming().subject is string && incoming().subject.size() > 0 && incoming().subject.size() <= 300
        && incoming().message is string && incoming().message.size() > 0 && incoming().message.size() <= 50000
        && (!('userId' in incoming()) || incoming().userId == null || (request.auth != null && incoming().userId == request.auth.uid));
      allow update, delete: if false;
    }
  }
}
